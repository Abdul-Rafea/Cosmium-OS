{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build main.cpp",
            "type": "process",
            "command": "C:/Gcc/bin/g++.exe",
            "args": [
                "-g",
                "-mwindows",
                "-municode",
                "-static-libgcc",
                "-static-libstdc++",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/direct-2D.cpp",
                "-ld3d11",
                "-ldxgi",
                "-ld2d1",
                "-lshlwapi",
                "-lole32",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "c:\\Gcc\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-mwindows",
                "-municode",
                "-static-libgcc",
                "-static-libstdc++",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/direct-2D.cpp",
                "-ld3d11",
                "-ldxgi",
                "-ld2d1",
                "-lshlwapi",
                "-lole32",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "c:\\Gcc\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}